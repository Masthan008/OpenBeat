<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/WidgetTitle"
        android:text="OpenBeat · Speed Dial"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/dial_item_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/widget_artwork_background"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_widget_cover" />

            <TextView
                style="@style/WidgetArtist"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="Favorite"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial_item_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/widget_artwork_background"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_widget_cover" />

            <TextView
                style="@style/WidgetArtist"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="Daily Mix"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial_item_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/widget_artwork_background"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_widget_cover" />

            <TextView
                style="@style/WidgetArtist"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="Trending"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dial_item_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/widget_artwork_background"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_widget_cover" />

            <TextView
                style="@style/WidgetArtist"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="Recent"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
