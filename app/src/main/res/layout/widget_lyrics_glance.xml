<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_artwork_background"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_cover" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D90E1015"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_artist"
            style="@style/WidgetArtist"
            android:layout_marginTop="0dp"
            android:text="NOW PLAYING · LYRICS"
            android:textColor="#9EFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_title"
            style="@style/WidgetTitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="3"
            android:text="Synced lyrics line flows here as the music plays…"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_like"
                style="@style/WidgetButton"
                android:contentDescription="@string/widget_like"
                android:src="@drawable/ic_widget_heart" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/widget_previous"
                style="@style/WidgetButton"
                android:contentDescription="@string/widget_previous"
                android:src="@drawable/ic_widget_previous" />

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_play_background"
                android:contentDescription="@string/widget_play"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play"
                android:tint="#FF12151C"
                tools:ignore="UseAppTint" />

            <ImageButton
                android:id="@+id/widget_next"
                style="@style/WidgetButton"
                android:contentDescription="@string/widget_next"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
