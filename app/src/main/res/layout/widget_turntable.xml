<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/turntable_disc_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/widget_turntable_vinyl" />

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_artwork_background"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_cover" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/turntable_disc_container"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            style="@style/WidgetTitle"
            android:gravity="center"
            android:text="@string/widget_nothing_playing"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_artist"
            style="@style/WidgetArtist"
            android:gravity="center"
            android:text="@string/widget_open"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/text_container"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_previous"
            style="@style/WidgetButton"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/ic_widget_previous" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/widget_play_background"
            android:contentDescription="@string/widget_play"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play"
            android:tint="#FF12151C"
            tools:ignore="UseAppTint" />

        <ImageButton
            android:id="@+id/widget_next"
            style="@style/WidgetButton"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</RelativeLayout>
