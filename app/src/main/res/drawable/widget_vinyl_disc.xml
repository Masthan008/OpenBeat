<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Vinyl Rim -->
    <item>
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="#FF1E2026" android:centerColor="#FF111216" android:endColor="#FF08090B" />
            <stroke android:width="2dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
    <!-- Outer Phonograph Groove Ring -->
    <item android:inset="8dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
    <!-- Middle Phonograph Groove Ring -->
    <item android:inset="16dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
    <!-- Inner Phonograph Groove Ring -->
    <item android:inset="24dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
    <!-- Center Label Border -->
    <item android:inset="32dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#66D4AF37" />
        </shape>
    </item>
</layer-list>
